{
  // Mirror your company's SonarQube quality gate.
  "QualityGate": {
    "MaxBlockerIssues": 0,
    "MaxCriticalIssues": 0,
    "MaxMajorIssues": 0,
    "MaxDuplicatedLinesPercent": 3.0,
    "FailOnUnknownSeverity": false
  },

  "Issues": {
    "Enabled": true,
    // Version of the SonarAnalyzer.CSharp NuGet package to inject at build time.
    "SonarAnalyzerVersion": "10.*",
    // Offline/locked-down machines: folder holding SonarAnalyzer.CSharp.dll (analyzers/dotnet/cs of the package).
    // When set, NuGet is not used for the analyzer.
    "SonarAnalyzerDirectory": "",
    // Quality profile rules + severities. Relative to this file.
    "RulesFile": "rules.json",
    "BuildConfiguration": "Debug",
    "IncludeNonSonarRules": false,
    // Same idea as sonar.exclusions in the pipeline (globs relative to the .sln folder).
    "Exclusions": [ "**/Migrations/**" ],
    "AdditionalBuildArguments": []
  },

  "Duplication": {
    "Enabled": true,
    "MinimumTokens": 100,
    "MinimumLines": 10,
    // Same idea as sonar.cpd.exclusions in the pipeline.
    "Exclusions": [ "**/Migrations/**" ]
  },

  // Optional: download rules.json straight from SonarQube when it is missing.
  // Token is read from the environment variable, e.g.  set LOCALSONAR_TOKEN=squ_xxx
  "SonarQube": {
    "Url": "",
    "QualityProfileKey": "",
    "TokenEnvironmentVariable": "LOCALSONAR_TOKEN",
    "RefreshRulesOnEachRun": false
  },

  // Empty = "reports" folder next to LocalSonar.exe (keeps your repo's git status clean).
  "OutputDirectory": "",
  "ExcludeTestProjects": true
}
